<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_auth"
    app:startDestination="@id/loginFragment">

    <fragment android:id="@+id/loginFragment"
        android:name="com.spendwise.app.ui.auth.LoginFragment"
        android:label="@string/login_title">
        <action android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action android:id="@+id/action_login_to_forgot"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>
    <fragment android:id="@+id/registerFragment"
        android:name="com.spendwise.app.ui.auth.RegisterFragment"
        android:label="@string/register_title" />
    <fragment android:id="@+id/forgotPasswordFragment"
        android:name="com.spendwise.app.ui.auth.ForgotPasswordFragment"
        android:label="@string/forgot_title" />
</navigation>
